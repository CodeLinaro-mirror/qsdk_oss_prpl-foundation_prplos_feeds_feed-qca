#!/bin/sh /etc/rc.common

START=00

# [ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

create_caldata_bin()
{
	local board=$(board_name)

	# load board.bin
	case "$board" in
		prpl,freedom)
			FILESIZE=184320
			FIRMWARE=ath12k/QCN92XX/hw1.0/cal-pci-0001:01:00.0.bin
			[ -e /lib/firmware/$FIRMWARE ] || caldata_extract_mmc "0:ART" 362496 $FILESIZE
			FIRMWARE=ath12k/QCN92XX/hw1.0/cal-pci-0002:01:00.0.bin
			[ -e /lib/firmware/$FIRMWARE ] || caldata_extract_mmc "0:ART" 567296 $FILESIZE
			FIRMWARE=ath12k/QCN92XX/hw1.0/cal-pci-0003:01:00.0.bin
			[ -e /lib/firmware/$FIRMWARE ] || caldata_extract_mmc "0:ART" 772096 $FILESIZE
			;;
	esac			
}

boot() {
	create_caldata_bin
}
