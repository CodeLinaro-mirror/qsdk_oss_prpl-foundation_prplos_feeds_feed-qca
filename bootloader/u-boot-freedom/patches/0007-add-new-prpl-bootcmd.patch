+#ifndef __PRPL_BOOT_H__
+#define __PRPL_BOOT_H__
+
+/**
+ * prpl_do_boot() - U-Boot command entrypoint for PRPL boot
+ * @argc: Argument count
+ * @argv: Argument vector
+ *
+ * This function serves as the exported command entry point.
+ * It optionally accepts a custom bootfile path.
+ *
+ * Usage:
+ *   prpl_boot [bootfile]
+ *
+ * If no bootfile is provided, DEFAULT_BOOTFILE is used.
+ *
+ * Return:
+ * CMD_RET_SUCCESS on success
+ * CMD_RET_FAILURE on failure
+ * CMD_RET_USAGE if invalid arguments are provided
+ */
+int prpl_do_boot(int argc, char *const argv[]);
+
+#endif /* __PRPL_BOOT_H__ */
