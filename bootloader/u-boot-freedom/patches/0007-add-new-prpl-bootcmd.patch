@@ -58,6 +75,190 @@ static int set_root_bootargs(int is_acti
 }
 
 /**
+ * get_booted_bank() - Retrieve booted bank from U-Boot DT
+ * @fdt: Pointer to U-Boot device tree blob
+ *
+ * Reads the "u-boot,booted-bank" property from /chosen node.
+ *
+ * Return:
+ * "active" or "inactive"
+ */
+static const char *get_booted_bank(const void *fdt)
+{
+	int node;
+	int len;
+	const char *bank;
+
+	if (!fdt || fdt_check_header(fdt))
+		return "active";
+
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node < 0)
+		return "active";
+
+	bank = fdt_getprop(fdt, node,
+			   "u-boot,booted-bank", &len);
+
+	if (!bank || len <= 0)
+		return "active";
+
+	if (len >= strlen("inactive") && !memcmp(bank, "inactive", strlen("inactive")))
+		return "inactive";
+
+	return "active";
+}
+
+
+#ifdef CONFIG_PRPL_BOOT_USE_EXT4LOAD
+/**
+ * load_fit_ext4() - Load FIT file from ext4 partition
+ * @volume: GPT partition name
+ * @filename: FIT filename inside filesystem
+ * @loadaddr: RAM address where FIT is loaded
+ *
+ * Uses filesystem layer (no CLI) to load a FIT image stored
+ * inside an ext4 formatted partition.
+ *
+ * Return:
+ * 0 on success
+ * Negative error code on failure
+ */
+static int load_fit_ext4(const char *part_name,
+                         const char *filename,
+                         ulong loadaddr)
+{
+    struct blk_desc *desc;
+    struct disk_partition info;
+    int part;
+    loff_t size;
+    int ret;
+
+    printf("Loading FIT %s from ext4 partition %s\n",
+           filename, part_name);
+
+    desc = blk_get_dev("mmc", 0);
+    if (!desc) {
+        printf("Cannot get MMC device\n");
+        return -ENODEV;
+    }
+
+    part = part_get_info_by_name(desc, part_name, &info);
+    if (part < 0) {
+        printf("Partition %s not found\n", part_name);
+        return -ENOENT;
+    }
+
+    ret = fs_set_blk_dev_with_part(desc, part);
+    if (ret) {
+        printf("Cannot set block device\n");
+        return ret;
+    }
+
+    ret = fs_read(filename, loadaddr, 0, 0, &size);
+    if (ret) {
+        printf("Failed to read file %s\n", filename);
+        return ret;
+    }
+
+    printf("Loaded %lld bytes\n", size);
+
+    return 0;
+}
+#else
+/**
+ * load_fit_raw() - Load FIT from raw GPT partition
+ * @volume: GPT partition name
+ * @loadaddr: RAM address where FIT is loaded
+ *
+ * Uses board_read_firmware() to read the full partition into memory.
+ *
+ * Return:
+ * 0 on success
+ * Negative error code on failure
+ */
+static int load_fit_raw(const char *volume, ulong loadaddr)
+{
+	printf("Loading raw FIT from partition %s\n", volume);
+
+	return board_read_firmware(volume, (char *)loadaddr);
+}
+#endif
+
+/**
+ * do_boot_prpl_common() - Main PRPL boot flow
+ *
+ * Supports two modes:
+ *   - Raw partition FIT image
+ *   - FIT file inside ext4 partition
+ *
+ * Return:
+ * CMD_RET_SUCCESS on success
+ * CMD_RET_FAILURE on failure
+ */
+static int do_boot_prpl_common(void)
+{
+	const void *fdt = gd->fdt_blob;
+	const char *bank;
+	const char *kernel_part;
+	ulong loadaddr;
+	char addr_str[32];
+    char *argv[2];
+	int ret;
+
+	loadaddr = env_get_hex("loadaddr",
+			       DEFAULT_KERNEL_LOADADDR);
+
+	bank = get_booted_bank(fdt);
+
+	if (!strcmp(bank, "inactive")) {
+		kernel_part = "kernel-inactive";
+		ret = set_root_bootargs(0);
+	} else {
+		kernel_part = "kernel-active";
+		ret = set_root_bootargs(1);
+	}
+
+	if (ret)
+		return CMD_RET_FAILURE;
+
+#ifdef CONFIG_PRPL_BOOT_USE_EXT4LOAD
+	ret = load_fit_ext4(kernel_part,
+			    DEFAULT_BOOTFILE,
+			    loadaddr);
+#else
+	ret = load_fit_raw(kernel_part,
+			   loadaddr);
+#endif
+
+	if (ret)
+		return CMD_RET_FAILURE;
+
+	printf("Booting FIT image at 0x%08lx\n", loadaddr);
+	snprintf(addr_str, sizeof(addr_str), "0x%lx", loadaddr);
+	argv[0] = "bootm";
+    argv[1] = addr_str;
+
+    return do_bootm(NULL, 0, 2, argv);
+}
+
+
+/**
+ * prpl_do_boot() - U-Boot command entry for PRPL boot
+ *
+ * Return:
+ * CMD_RET_SUCCESS on success
+ * CMD_RET_FAILURE on failure
+ */
+int prpl_do_boot(int argc, char *const argv[])
+{
+	if (argc > 1)
+		return CMD_RET_USAGE;
+
+	return do_boot_prpl_common();
+}
+
+
+/**
  * ft_system_setup() - Overwrite ft_system_setup()
  *
  * ft_system_setup() is used to pass the booted bank information in the Linux
@@ -90,31 +291,50 @@ int ft_system_setup(void *blob, struct b
 		goto out;
 	}
 
