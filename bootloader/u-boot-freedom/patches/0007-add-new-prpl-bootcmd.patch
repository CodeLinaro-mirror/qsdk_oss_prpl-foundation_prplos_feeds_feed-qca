+#include <common.h>
+#include <command.h>
+
+#include <prpl/prpl_boot.h>
+
+static int do_bootprpl_cmd(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	(void)cmdtp;
+	(void)flag;
+	return prpl_do_boot(argc, argv);
+}
+
+U_BOOT_CMD(
+	bootprpl, 2, 0, do_bootprpl_cmd,
+	"PRPL banked boot (select bank from DT, load FIT, bootm default config)",
+	"[bootfile]\n"
