--- iperf-3.17.1.orig/src/iperf_client_api.c
+++ iperf-3.17.1/src/iperf_client_api.c
@@ -495,6 +495,21 @@ iperf_connect(struct iperf_test *test)
     return 0;
 }
 
+#if defined(HAVE_SO_OFFLOAD)
+void
+iperf_client_disable_offload(struct iperf_test *test)
+{
+    struct iperf_stream *sp;
+    int offload = 0;
+
+    /* Disable socket offload for all relevant stream sockets */
+    SLIST_FOREACH(sp, &test->streams, streams) {
+        if (setsockopt(sp->socket, SOL_SOCKET, SO_OFFLOAD, &offload, sizeof(offload)) < 0) {
+            printf("Failed to unset SO_OFFLOAD socket option from iperf_client_disable_offload\n");
+        }
+    }
+}
+#endif /* HAVE_SO_OFFLOAD */
 
 int
 iperf_client_end(struct iperf_test *test)
@@ -506,6 +521,12 @@ iperf_client_end(struct iperf_test *test
     }
     struct iperf_stream *sp;
 
+#if defined(HAVE_SO_OFFLOAD)
+    if (test->offload) {
+	iperf_client_disable_offload(test);
+    }
+#endif /* HAVE_SO_OFFLOAD */
+
     /* Close all stream sockets */
     SLIST_FOREACH(sp, &test->streams, streams) {
         close(sp->socket);
