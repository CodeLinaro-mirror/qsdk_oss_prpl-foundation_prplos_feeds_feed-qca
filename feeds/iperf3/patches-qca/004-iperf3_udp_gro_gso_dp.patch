+/*
+ * iperf_udp_recv_gro
+ *	Process the GROed packets
+ */
+int iperf_udp_recv_gro(struct iperf_stream *sp)
+{
+	struct iperf_time sent_time, arrival_time, temp_time;
+	int sock_opt = 0, num_segment = 0, r;
+	int size = sp->settings->blksize;
+	double transit = 0, d = 0;
+	int first_packet = 0;
+	uint32_t  sec, usec;
+	uint64_t  start_seq, end_seq;
+
+#if defined(HAVE_MSG_TRUNC)
+	/*
+	 * UDP recv() with MSG_TRUNC reads only the size bytes,
+	 * but returns the length of the full packet
+	 */
+	if (sp->test->settings->skip_rx_copy) {
+		sock_opt = MSG_TRUNC;
+		size = sizeof(sec) + sizeof(usec) + sizeof(start_seq);
+	}
+#endif /* HAVE_MSG_TRUNC */
+
+	r = Nrecv_gro(sp->socket, sp->buffer, size, sp->cmsg_buf, &num_segment, sock_opt);
+
+	/*
+	 * If we got an error in the read, or if we didn't read anything
+	 * because the underlying read(2) got a EAGAIN, then skip packet
+	 * processing.
+	 */
+	if (r <= 0) {
+		return r;
+	}
+
+	/*
+	 * Below processing is as per iperf_udp_recv() which has been
+	 * modified for GRO (multiple packet) packets.
+	 */
+
+	/*
+	 * Only count bytes received while we're in the correct state.
+	 */
+	if (sp->test->state == TEST_RUNNING) {
+		/*
+		 * For jitter computation below, it's important to know if this
+		 * packet is the first packet received.
+		 */
+		if (sp->result->bytes_received == 0) {
+			first_packet = 1;
+		}
+
+		sp->result->bytes_received += r;
+		sp->result->bytes_received_this_interval += r;
+
+		/*
+		 * Dig the various counters out of the incoming UDP packet
+		 */
+		memcpy(&sec, sp->buffer, sizeof(sec));
+		memcpy(&usec, sp->buffer + 4, sizeof(usec));
+		sec = ntohl(sec);
+		usec = ntohl(usec);
+		sent_time.secs = sec;
+		sent_time.usecs = usec;
+
+		if (sp->test->udp_counters_64bit) {
+			memcpy(&start_seq, sp->buffer + 8, sizeof(start_seq));
+			start_seq = be64toh(start_seq);
+		} else {
+			uint32_t pc;
+			memcpy(&pc, sp->buffer + 8, sizeof(pc));
+			start_seq = ntohl(pc);
+		}
+
+		end_seq = start_seq + (num_segment - 1);
+
+		if (sp->test->debug_level >= DEBUG_LEVEL_DEBUG) {
+			fprintf(stderr, "start sequence %" PRIu64 " end sequence %" PRIu64
+				" packet_count %" PRIu64 "\n", start_seq, end_seq, sp->packet_count);
+		}
+
+		/*
+		 * Try to handle out of order packets.
+		 * First figure out if the sequence numbers are going forward.
+		 * start_seq is the sequence number read from the packet,
+		 * end_seq is the sequence number of last segment in the GROed packet
+		 * and sp->packet_count is the highest sequence number seen so
+		 * far (so we're expecting to see the packet with sequence number
+		 * sp->packet_count + 1 arrive next).
+		 */
+		if (start_seq >= sp->packet_count + 1) {
+			/*
+			 * Forward, but check if there is any gap
+			 * in sequence numbers
+			 */
+			if (start_seq > sp->packet_count + 1) {
+				/*
+				 * There's a gap so count that as a loss.
+				 */
+				sp->cnt_error += (start_seq - 1) - sp->packet_count;
+			}
+			/*
+			 * Update the highest sequence number seen so far.
+			 */
+			sp->packet_count = end_seq;
+		} else {
+			/*
+			 * Sequence number went backward
+			 * This counts as an out-of-order packet
+			 */
+			sp->outoforder_packets += num_segment;
+
+			/*
+			 * If we have lost packets, then the fact that we are now
+			 * seeing an out-of-order packet offsets a prior sequence
+			 * number gap that was counted as a loss.  So we can take
+			 * away a loss.
+			 */
+			if (sp->cnt_error >= num_segment) {
+				sp->cnt_error -= num_segment;
+			} else {
+				sp->cnt_error = 0;
+			}
+
+			if (sp->test->debug) {
+				fprintf(stderr, "OUT OF ORDER - incoming packet sequence %"
+						PRIu64 " but expected sequence %" PRIu64 " on stream %d",
+						start_seq, sp->packet_count + 1, sp->socket);
+			}
+		}
+
+		/*
+		 * jitter measurement
+		 *
+		 * This computation is based on RFC 1889 (specifically
+		 * sections 6.3.1 and A.8).
+		 *
+		 * Note that synchronized clocks are not required since
+		 * the source packet delta times are known.  Also this
+		 * computation does not require knowing the round-trip
+		 * time.
+		 */
+		iperf_time_now(&arrival_time);
+
+		iperf_time_diff(&arrival_time, &sent_time, &temp_time);
+		transit = iperf_time_in_secs(&temp_time);
+
+		/*
+		 * Hack to handle the first packet by initializing prev_transit.
+		 */
+		if (first_packet) {
+			sp->prev_transit = transit;
+		}
+
+		d = transit - sp->prev_transit;
+		if (d < 0)
+			d = -d;
+		sp->prev_transit = transit;
+		sp->jitter += (d - sp->jitter) / 16.0;
+	} else {
+		if (sp->test->debug)
+			fprintf(stderr,"Late receive, state = %d\n", sp->test->state);
+	}
+
+	return r;
+}
+
+/*
+ * iperf_udp_send_gso
+ *	Send large UDP buffer
+ */
+int iperf_udp_send_gso(struct iperf_stream *sp)
+{
+	int buf_len = sp->settings->blksize;
+	int size = sp->settings->udp_gso_len;
+	struct iperf_time before;
+        char *buf = sp->buffer;
+	uint32_t  sec, usec;
+	int tx_len = 0, r;
+
+	iperf_time_now(&before);
+	sec = htonl(before.secs);
+	usec = htonl(before.usecs);
+
+	while (buf_len >= size) {
+		++sp->packet_count;
+
+		if (sp->test->udp_counters_64bit) {
+			uint64_t  pcount;
+
+			pcount = htobe64(sp->packet_count);
+			memcpy(buf, &sec, sizeof(sec));
+			memcpy(buf + 4, &usec, sizeof(usec));
+			memcpy(buf + 8, &pcount, sizeof(pcount));
+		} else {
+			uint32_t pcount;
+
+			pcount = htonl(sp->packet_count);
+			memcpy(buf, &sec, sizeof(sec));
+			memcpy(buf + 4, &usec, sizeof(usec));
+			memcpy(buf + 8, &pcount, sizeof(pcount));
+		}
+
+		buf_len -= size;
+		tx_len += size;
+		buf += size;
+	}
+
+	r = Nwrite(sp->socket, sp->buffer, tx_len, Pudp);
+	if (r <= 0) {
+		/*
+		 * Don't count messages that no data was sent from them.
+		 * Allows "resending" a massage with the same numbering
+		 */
+		sp->packet_count -= (tx_len / size);
+
+		if (r < 0) {
+			if (r == NET_SOFTERROR && sp->test->debug_level >= DEBUG_LEVEL_INFO)
+				fprintf(stderr,"UDP send failed on NET_SOFTERROR. errno=%s\n", strerror(errno));
+			return r;
+		}
+	}
+
+	sp->result->bytes_sent += r;
+	sp->result->bytes_sent_this_interval += r;
+
+	if (sp->test->debug_level >=  DEBUG_LEVEL_DEBUG) {
+		fprintf(stderr,"sent %d bytes of %d, total %" PRIu64 "\n", r, sp->settings->blksize, sp->result->bytes_sent);
+	}
+
+	return r;
+}
+#endif /* HAVE_SO_OFFLOAD */
 
