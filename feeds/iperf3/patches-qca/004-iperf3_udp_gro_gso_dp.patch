+/*
+ * Nrecv_gro
+ *	Receive GRO packets
+ */
+int Nrecv_gro(int fd, char *buf, size_t buf_size, char *cmsg_buf, int *num_segment, int sock_opt)
+{
+	ssize_t bytes_received;
+	struct cmsghdr *cmsg;
+	int segment_size = 0;
+	struct msghdr msg;
+	struct iovec iov;
+
+	iov.iov_base = buf;
+	iov.iov_len = buf_size;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	msg.msg_control = cmsg_buf;
+	msg.msg_controllen = UDP_CMSG_BUF_LEN;
+
+	bytes_received = recvmsg(fd, &msg, sock_opt);
+
+	if (bytes_received < 0) {
+		perror("recvmsg failed");
+		return -1;
+	}
+
+	/*
+	 *  cmsg contains multiple return options,hence requires iteration.
+	 *  For iperf3 offload, UDP_GRO will mostly likely be the first option
+	 */
+	for (cmsg = CMSG_FIRSTHDR(&msg); cmsg != NULL; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+		if (cmsg->cmsg_level == SOL_UDP && cmsg->cmsg_type == UDP_GRO) {
+			segment_size = *(int *)CMSG_DATA(cmsg);
+			break;
+		}
+	}
+
+	/*
+	 * Not a GRO packet, segment size is equal to received bytes.
+	 */
+	if (!segment_size) {
+		segment_size = bytes_received;
+	}
+
+	*num_segment = bytes_received / segment_size;
+
+	return bytes_received;
+}
