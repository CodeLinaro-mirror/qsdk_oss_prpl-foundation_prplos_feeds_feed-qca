From 13d9298bc5e59281de647b944d66cf14b0cf0c3c Mon Sep 17 00:00:00 2001
From: Sathishkumar Muruganandam <murugana@qti.qualcomm.com>
Date: Tue, 19 May 2026 19:21:18 +0530
Subject: [PATCH] UPSTREAM:DP:wifi:ath12k:clean up orphan DP peers after stale
 link peer cleanup

When vdev deletion times out, ath12k_peer_cleanup() removes stale
ath12k_dp_link_peer entries but can leave the parent MLO ath12k_dp_peer
in ah->dp_hw.peers with no remaining link peers.

A later MLO STA reconnect using the same MLD address then hits the stale
DP peer in ath12k_dp_peer_create(), returns -EEXIST, and mac80211 reports:

failed to insert STA entry for the AP (error -17)

This repeats on every reconnect attempt because each retry allocates a
new ml_peer_id but fails before replacing the stale DP peer.

Add an orphan DP peer cleanup helper and invoke it after stale link peer
cleanup. The helper removes only non-vdev DP peers whose peer_links_map is
empty, and clears the MLO dp_peer_list[] RCU pointer before freeing the
peer.

This keeps the normal peer delete path unchanged while preventing stale
orphan DP peers from blocking future STA insertion.

Patch-dependency:None

Change-Id: Ic9a3f225d22b037e91c194694b0a3b117bb28474
Signed-off-by: Sathishkumar Muruganandam <murugana@qti.qualcomm.com>
---
 .../drivers/net/wireless/ath/ath12k/dp_peer.c | 40 +++++++++++++++++++
 .../drivers/net/wireless/ath/ath12k/dp_peer.h |  1 +
 .../drivers/net/wireless/ath/ath12k/peer.c    |  5 +++
 3 files changed, 46 insertions(+)

diff --git a/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.c b/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.c
index 2741caeacf7e..263210e2ad1a 100644
--- a/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.c
+++ b/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.c
@@ -654,6 +654,46 @@ void ath12k_dp_peer_delete(struct ath12k_dp_hw *dp_hw, u8 *addr,
 	kfree(dp_peer);
 }
 
+int ath12k_dp_peer_cleanup_orphan(struct ath12k_dp_hw *dp_hw)
+{
+	struct ath12k_dp_peer *dp_peer, *tmp;
+	struct list_head cleanup_list;
+	int count = 0;
+
+	INIT_LIST_HEAD(&cleanup_list);
+
+	spin_lock_bh(&dp_hw->peer_lock);
+
+	list_for_each_entry_safe(dp_peer, tmp, &dp_hw->peers, list) {
+		if (dp_peer->is_vdev_peer || dp_peer->peer_links_map)
+			continue;
+
+		if (dp_peer->is_mlo && dp_peer->peer_id < MAX_DP_PEER_LIST_SIZE)
+			rcu_assign_pointer(dp_hw->dp_peer_list[dp_peer->peer_id], NULL);
+
+		list_del(&dp_peer->list);
+		list_add_tail(&dp_peer->list, &cleanup_list);
+		count++;
+	}
+
+	spin_unlock_bh(&dp_hw->peer_lock);
+
+	if (count > 0)
+		synchronize_rcu();
+
+	list_for_each_entry_safe(dp_peer, tmp, &cleanup_list, list) {
+		list_del(&dp_peer->list);
+
+		if (dp_peer->qos && dp_peer->qos->telemetry_peer_ctx)
+			ath12k_telemetry_peer_ctx_free(dp_peer->qos->telemetry_peer_ctx);
+
+		kfree(dp_peer->qos);
+		kfree(dp_peer);
+	}
+
+	return count;
+}
+
 int ath12k_dp_link_peer_assign(struct ath12k *ar, u8 vdev_id,
 			       struct ieee80211_sta *sta, u8 *addr, u8 link_id,
 			       u32 hw_link_id, struct ieee80211_vif *vif,
diff --git a/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.h b/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.h
index 16c6ebfcf370..aabcf60de725 100644
--- a/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.h
+++ b/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/dp_peer.h
@@ -279,6 +279,7 @@ int ath12k_dp_peer_create(struct ath12k_dp_hw *dp_hw, u8 *addr,
 			  struct ieee80211_vif *vif);
 void ath12k_dp_peer_delete(struct ath12k_dp_hw *dp_hw, u8 *addr,
 			   struct ieee80211_sta *sta, u8 hw_link_id);
+int ath12k_dp_peer_cleanup_orphan(struct ath12k_dp_hw *dp_hw);
 struct ath12k_dp_peer *ath12k_dp_peer_find_by_peerid_index(struct ath12k_dp *dp,
 							   struct ath12k_pdev_dp *dp_pdev,
 							   u16 peer_id);
diff --git a/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/peer.c b/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/peer.c
index 1d70e4ee17ac..78b458fe6e54 100644
--- a/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/peer.c
+++ b/backports-6.1-9a0dddfb3/drivers/net/wireless/ath/ath12k/peer.c
@@ -79,6 +79,11 @@ void ath12k_peer_cleanup(struct ath12k *ar, u32 vdev_id)
 		ath12k_dbg(ab, ATH12K_DBG_PEER,
 			   "cleaned up %d stale peers from vdev_id %d\n",
 			   count, vdev_id);
+
+		count = ath12k_dp_peer_cleanup_orphan(&ar->ah->dp_hw);
+		if (count > 0)
+			ath12k_dbg(ab, ATH12K_DBG_PEER,
+				   "cleaned up %d orphan dp peers\n", count);
 	}
 }
 
