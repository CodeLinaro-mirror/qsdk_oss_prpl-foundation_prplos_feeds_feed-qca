From 051a2eab5931faae49873edea793aa486674af3a Mon Sep 17 00:00:00 2001
From: Sathishkumar Muruganandam <murugana@qti.qualcomm.com>
Date: Tue, 2 Jun 2026 16:44:58 +0530
Subject: [PATCH 2/2] wifi:ath12k: make peer wait helper handle create failure
 status

Peer creation now needs to stop waiting not only when the HTT peer map
arrives, but also when firmware reports a peer create failure. This is
used by the stale peer cleanup path, where a BSS peer exists response is
handled by deleting the stale peer and retrying peer creation.

Refactor ath12k_wait_for_peer_common() to accept an optional completion
predicate and return the final mapped state to the caller. This keeps the
common peer mapping wait logic shared by both create and delete paths,
while allowing ath12k_wait_for_peer_created() to also wake on peer create
failure status and translate firmware status codes to Linux errors.

Use READ_ONCE()/WRITE_ONCE() for the peer create status handoff between
the WMI event handler and the waiter.

Signed-off-by: Sathishkumar Muruganandam <murugana@qti.qualcomm.com>
---
 drivers/net/wireless/ath/ath12k/core.h |  3 ++
 drivers/net/wireless/ath/ath12k/peer.c | 69 +++++++++++++++++++++++---
 drivers/net/wireless/ath/ath12k/wmi.c  | 10 ++++
 3 files changed, 76 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
index 8f86740667d3..292153ef5fea 100644
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -1330,6 +1330,9 @@ struct ath12k {
 
 	struct completion peer_assoc_done;
 	struct completion peer_delete_done;
+	u32 last_wmi_peer_create_status;
+	u32 last_wmi_peer_create_vdev_id;
+	u8 last_wmi_peer_create_addr[ETH_ALEN];
 
 	int install_key_status;
 	struct completion install_key_done;
diff --git a/drivers/net/wireless/ath/ath12k/peer.c b/drivers/net/wireless/ath/ath12k/peer.c
index 0ed168bd9eea..e1f57e86544c 100644
--- a/drivers/net/wireless/ath/ath12k/peer.c
+++ b/drivers/net/wireless/ath/ath12k/peer.c
@@ -14,18 +14,22 @@
 #include "telemetry_agent_if.h"
 
 static int ath12k_wait_for_peer_common(struct ath12k_base *ab, int vdev_id,
-				       const u8 *addr, bool expect_mapped)
+				       const u8 *addr, bool expect_mapped,
+				       bool (*done)(void *ctx), void *ctx,
+				       bool *is_mapped)
 {
+	bool mapped = false;
 	int ret;
 
 	ret = wait_event_timeout(ab->peer_mapping_wq, ({
-				bool mapped;
-
 				spin_lock_bh(&ab->dp->dp_lock);
 				mapped = !!ath12k_dp_link_peer_find_by_vdev_id_and_addr(ab->dp, vdev_id, addr);
 				spin_unlock_bh(&ab->dp->dp_lock);
+				if (is_mapped)
+					*is_mapped = mapped;
 
 				(mapped == expect_mapped ||
+				 (done && done(ctx)) ||
 				 test_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags));
 				}), 3 * HZ);
 
@@ -35,6 +39,15 @@ static int ath12k_wait_for_peer_common(struct ath12k_base *ab, int vdev_id,
 	return 0;
 }
 
+static bool ath12k_peer_create_failed(void *ctx)
+{
+	struct ath12k *ar = ctx;
+	u32 status = READ_ONCE(ar->last_wmi_peer_create_status);
+
+	return status != ATH12K_WMI_PEER_CREATRE_STATUS_MAX &&
+	       status != ATH12K_WMI_PEER_CREATE_SUCCESS;
+}
+
 struct ath12k_peer_cleanup_ctx {
 	struct ath12k *ar;
 	u32 vdev_id;
@@ -84,7 +97,8 @@ void ath12k_peer_cleanup(struct ath12k *ar, u32 vdev_id)
 
 static int ath12k_wait_for_peer_deleted(struct ath12k *ar, int vdev_id, const u8 *addr)
 {
-	return ath12k_wait_for_peer_common(ar->ab, vdev_id, addr, false);
+	return ath12k_wait_for_peer_common(ar->ab, vdev_id, addr, false,
+						 NULL, NULL, NULL);
 }
 
 int ath12k_wait_for_peer_delete_done(struct ath12k *ar, u32 vdev_id,
@@ -189,7 +203,32 @@ int ath12k_peer_delete(struct ath12k *ar, u32 vdev_id, u8 *addr,
 
 static int ath12k_wait_for_peer_created(struct ath12k *ar, int vdev_id, const u8 *addr)
 {
-	return ath12k_wait_for_peer_common(ar->ab, vdev_id, addr, true);
+	struct ath12k_base *ab = ar->ab;
+	bool mapped = false;
+	u32 status;
+	int ret;
+
+	ret = ath12k_wait_for_peer_common(ab, vdev_id, addr, true,
+						 ath12k_peer_create_failed, ar,
+						 &mapped);
+	if (ret)
+		return ret;
+
+	if (mapped)
+		return 0;
+
+	if (test_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags))
+		return -ESHUTDOWN;
+
+	status = READ_ONCE(ar->last_wmi_peer_create_status);
+
+	if (status == ATH12K_WMI_PEER_BSS_PEER_EXISTS)
+		return -EEXIST;
+
+	if (status == ATH12K_WMI_PEER_AST_FULL)
+		return -ENOSPC;
+
+	return -EINVAL;
 }
 
 int ath12k_peer_create(struct ath12k *ar, struct ath12k_link_vif *arvif,
@@ -201,8 +240,9 @@ int ath12k_peer_create(struct ath12k *ar, struct ath12k_link_vif *arvif,
 	struct ath12k_link_sta *arsta;
 	u8 link_id = arvif->link_id;
 	struct ath12k_dp_link_peer *peer;
-	struct ath12k_sta *ahsta;
+	struct ath12k_sta *ahsta = NULL;
 	u16 ml_peer_id;
+	bool stale_peer_deleted = false;
 	int ret;
 	struct ath12k_dp_link_vif *dp_link_vif = &ahvif->dp_vif.dp_link_vif[link_id];
 
@@ -226,6 +266,11 @@ int ath12k_peer_create(struct ath12k *ar, struct ath12k_link_vif *arvif,
 	}
 	spin_unlock_bh(&ar->ab->dp->dp_lock);
 
+retry_peer_create:
+	WRITE_ONCE(ar->last_wmi_peer_create_status,
+		   ATH12K_WMI_PEER_CREATRE_STATUS_MAX);
+	ar->last_wmi_peer_create_vdev_id = arg->vdev_id;
+	ether_addr_copy(ar->last_wmi_peer_create_addr, arg->peer_addr);
 	ret = ath12k_wmi_send_peer_create_cmd(ar, arg);
 	if (ret) {
 		ath12k_warn(ar->ab,
@@ -236,6 +281,18 @@ int ath12k_peer_create(struct ath12k *ar, struct ath12k_link_vif *arvif,
 
 	ret = ath12k_wait_for_peer_created(ar, arg->vdev_id,
 					   arg->peer_addr);
+	if (ret == -EEXIST && !stale_peer_deleted) {
+		ath12k_warn(ar->ab,
+			    "stale peer %pM exists for vdev_id %d, deleting and retrying\n",
+			    arg->peer_addr, arg->vdev_id);
+
+		ret = __ath12k_peer_delete(ar, arg->vdev_id, arg->peer_addr, ahsta);
+		if (ret)
+			return ret;
+
+		stale_peer_deleted = true;
+		goto retry_peer_create;
+	}
 	if (ret)
 		return ret;
 
diff --git a/drivers/net/wireless/ath/ath12k/wmi.c b/drivers/net/wireless/ath/ath12k/wmi.c
index 974b4f45b2d8..d7c439bb2bb7 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -14057,12 +14057,22 @@ static void ath12k_wmi_peer_create_conf_event(struct ath12k_base *ab,
 					      struct sk_buff *skb)
 {
 	struct ath12k_wmi_peer_create_conf_arg arg = {};
+	struct ath12k *ar;
 
 	if (ath12k_pull_peer_create_conf_ev(ab, skb, &arg)) {
 		ath12k_warn(ab, "failed to extract peer create conf event");
 		return;
 	}
 
+	rcu_read_lock();
+	ar = ath12k_mac_get_ar_by_vdev_id(ab, arg.vdev_id);
+	if (ar && ar->last_wmi_peer_create_vdev_id == arg.vdev_id &&
+	    ether_addr_equal(ar->last_wmi_peer_create_addr, arg.mac_addr)) {
+		WRITE_ONCE(ar->last_wmi_peer_create_status, arg.status);
+		wake_up(&ab->peer_mapping_wq);
+	}
+	rcu_read_unlock();
+
 	if (arg.status != ATH12K_WMI_PEER_CREATE_SUCCESS) {
 		ath12k_warn(ab, "Peer %pM creation failed due to %d",
 			    arg.mac_addr, arg.status);
-- 
2.34.1

