{
	"user": "network",
	"access": {
		"service": {
			"methods": [ "event" ]
		},
		"wpa_supplicant": {
			"methods": [ "phy_set_state", "phy_set_macaddr_list", "phy_status", "csa_finish_event", "start_scan_post_acs", "uplink_csa_notify", "disconnect_request", "get_sta_channel_per_band" ]
		},
		"hostapd": {
			"methods": [ "apsta_state" ]
		},
		"rptr_mgr": {
			"methods": [ "forward_to_hostapd", "csa_finish_event_to_supp", "acs_completed" ]
		},
		"udebug": {
			"methods": [ "get_config" ]
		}
	},
	"subscribe": [ "udebug", "rptr_mgr" ],
	"publish": [ "hostapd", "hostapd.*", "wpa_supplicant", "wpa_supplicant.*", "rptr_mgr", "rptr_mgr.*" ],
	"send": [ "bss.*", "wps_credentials" ]
}
