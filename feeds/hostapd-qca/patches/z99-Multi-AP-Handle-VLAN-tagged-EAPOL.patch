From 522dd4b1a6baf12dc30e302797a20bac0c3c753e Mon Sep 17 00:00:00 2001
From: Volodymyr Pavlenko <pavlenko.vv@pm.me>
Date: Fri, 29 May 2026 11:52:44 +0300
Subject: [PATCH] UPSTREAM:PROTOCOL:hostapd:wpa_supplicant: Handle Multi-AP
 VLAN EAPOL

Multi-AP backhaul onboarding can exchange EAPOL frames with an
802.1Q header when the association response advertises a primary
VLAN. Handle this in the control-port path, matching the MaxLinear
implementation style instead of learning the VID in the raw L2 socket
code.

Carry the control-port VLAN ID into EVENT_EAPOL_RX, unwrap 802.1Q
control-port payloads before the WPA state machine sees them, validate
tagged frames against the expected Multi-AP VLAN on AP and supplicant
RX, and wrap outgoing EAPOL payloads with a VLAN header when the
expected VLAN is configured. Untagged EAPOL remains accepted so both
peer behaviours continue to work.

Patch-dependency: z011-Multi-AP-Add-wpa-supp.patch

Signed-off-by: Volodymyr Pavlenko <pavlenko.vv@pm.me>
---
diff --git a/src/ap/ap_drv_ops.c b/src/ap/ap_drv_ops.c
index 14e6ba9..aba4091 100644
--- a/src/ap/ap_drv_ops.c
+++ b/src/ap/ap_drv_ops.c
@@ -51,6 +51,8 @@ u32 hostapd_sta_flags_to_drv(u32 flags)
 		res |= WPA_STA_SPP_AMSDU;
 	if (flags & WLAN_STA_FT_AUTH)
 		res |= WPA_STA_FT_AUTH;
+	if (flags & WLAN_STA_MULTI_AP)
+		res |= WPA_STA_MULTI_AP;
 
 	return res;
 }
