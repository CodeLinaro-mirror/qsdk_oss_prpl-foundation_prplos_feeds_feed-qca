 #define WPA_STA_FT_AUTH BIT(8)
+#define WPA_STA_MULTI_AP BIT(9)
 
 enum tdls_oper {
 	TDLS_DISCOVERY_REQ,
@@ -7509,6 +7510,7 @@ union wpa_event_data {
 		size_t data_len;
 		enum frame_encryption encrypted;
 		int link_id;
+		u16 vlan_id;
 	} eapol_rx;
 
 	/**
@@ -8047,6 +8049,22 @@ static inline void drv_event_eapol_rx2(void *ctx, const u8 *src, const u8 *data,
 	wpa_supplicant_event(ctx, EVENT_EAPOL_RX, &event);
 }
 
+static inline void drv_event_eapol_rx_vlan(void *ctx, const u8 *src,
+					   const u8 *data, size_t data_len,
+					   enum frame_encryption encrypted,
+					   int link_id, u16 vlan_id)
+{
+	union wpa_event_data event;
+	os_memset(&event, 0, sizeof(event));
+	event.eapol_rx.src = src;
+	event.eapol_rx.data = data;
+	event.eapol_rx.data_len = data_len;
+	event.eapol_rx.encrypted = encrypted;
+	event.eapol_rx.link_id = link_id;
+	event.eapol_rx.vlan_id = vlan_id;
+	wpa_supplicant_event(ctx, EVENT_EAPOL_RX, &event);
+}
+
