+static bool multi_ap_eapol_vlan_id_check(struct wpa_supplicant *wpa_s,
+					 const u8 *src, u16 vlan_id)
+{
+	u16 multi_ap_primary_vlanid = wpa_s->multi_ap_primary_vlanid;
+
+	if (wpa_s->multi_ap_backhaul && vlan_id && !multi_ap_primary_vlanid) {
+		wpa_s->multi_ap_primary_vlanid = vlan_id;
+		multi_ap_primary_vlanid = vlan_id;
+		wpa_printf(MSG_DEBUG,
+			   "Multi-AP: learned primary_vlan_id=%u from EAPOL",
+			   vlan_id);
+	}
+
+	if (src && multi_ap_primary_vlanid && vlan_id &&
+	    multi_ap_primary_vlanid != vlan_id) {
+		wpa_printf(MSG_ERROR,
+			   "Dropping EAPOL frame(vlan:%u) from " MACSTR
+			   " vlan_id mismatch(%u)",
+			   vlan_id, MAC2STR(src), multi_ap_primary_vlanid);
+		return false;
+	}
+
+	return true;
+}
+
