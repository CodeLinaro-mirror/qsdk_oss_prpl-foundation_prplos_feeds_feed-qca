+			   " vlan_id mismatch(%u)",
+			   vlan_id, MAC2STR(src), hapd->conf->multi_ap_vlanid);
+		return;
+	}
+
 	ieee802_1x_receive(hapd, src, data, data_len, encrypted);
 }
 
