 	/* For now, disable EAPOL TX over control port in AP mode by default
 	 * since it does not provide TX status notifications. */
 	if (drv->control_port_ap &&
-	    (drv->capa.flags & WPA_DRIVER_FLAGS_CONTROL_PORT))
+	    (drv->capa.flags & WPA_DRIVER_FLAGS_CONTROL_PORT)) {
+#ifdef CONFIG_AP
+		struct hostapd_data *hapd = bss->ctx;
+		u8 *vlan_data = NULL;
+		size_t len = data_len;
+		u16 proto = ETH_P_EAPOL;
+		int ret;
+
+		if ((flags & WPA_STA_MULTI_AP) &&
+		    hapd->conf->multi_ap == BACKHAUL_BSS &&
+		    hapd->conf->multi_ap_vlanid)
+			proto = ieee802_11_add_vlan_hdr(
+				&vlan_data, hapd->conf->multi_ap_vlanid,
+				proto, data, &len);
+
+		ret = nl80211_tx_control_port(bss, addr, proto,
+					      vlan_data ? vlan_data : data,
+					      len, !encrypt, link_id);
+		os_free(vlan_data);
+		return ret;
+#else /* CONFIG_AP */
 		return nl80211_tx_control_port(bss, addr, ETH_P_EAPOL,
 					       data, data_len, !encrypt,
 					       link_id);
+#endif /* CONFIG_AP */
+	}
 
 	return nl80211_send_eapol_data(bss, addr, data, data_len);
 }
diff --git a/src/drivers/driver_nl80211_event.c b/src/drivers/driver_nl80211_event.c
index 8a6d755..28ac518 100644
--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -4985,35 +4985,74 @@ static void nl80211_control_port_frame(struct i802_bss *bss, struct nlattr **tb)
 {
 	u8 *src_addr;
+	const u8 *frame;
+	size_t frame_len;
 	u16 ethertype;
+	u16 inner_proto;
+	u16 vlan_id;
 	enum frame_encryption encrypted;
 	int link_id;
 
 	if (!tb[NL80211_ATTR_MAC] ||
 	    !tb[NL80211_ATTR_FRAME] ||
 	    !tb[NL80211_ATTR_CONTROL_PORT_ETHERTYPE])
 		return;
 
 	src_addr = nla_data(tb[NL80211_ATTR_MAC]);
+	frame = nla_data(tb[NL80211_ATTR_FRAME]);
+	frame_len = nla_len(tb[NL80211_ATTR_FRAME]);
 	ethertype = nla_get_u16(tb[NL80211_ATTR_CONTROL_PORT_ETHERTYPE]);
+	vlan_id = tb[NL80211_ATTR_VLAN_ID] ?
+		nla_get_u16(tb[NL80211_ATTR_VLAN_ID]) : 0;
 	encrypted = nla_get_flag(tb[NL80211_ATTR_CONTROL_PORT_NO_ENCRYPT]) ?
 		FRAME_NOT_ENCRYPTED : FRAME_ENCRYPTED;
 
 	if (tb[NL80211_ATTR_MLO_LINK_ID])
 		link_id = nla_get_u8(tb[NL80211_ATTR_MLO_LINK_ID]);
 	else
 		link_id = -1;
 
 	switch (ethertype) {
 	case ETH_P_RSN_PREAUTH:
 		wpa_printf(MSG_INFO, "nl80211: Got pre-auth frame from "
 			   MACSTR " over control port unexpectedly",
 			   MAC2STR(src_addr));
 		break;
 	case ETH_P_PAE:
-		drv_event_eapol_rx2(bss->ctx, src_addr,
-				    nla_data(tb[NL80211_ATTR_FRAME]),
-				    nla_len(tb[NL80211_ATTR_FRAME]),
-				    encrypted, link_id);
+		if (frame_len >= 4 && WPA_GET_BE16(frame + 2) == ETH_P_PAE) {
+			frame = ieee802_11_parse_vlan_hdr(frame, &frame_len,
+							  &vlan_id,
+							  &inner_proto);
+			if (!frame)
+				break;
+		}
+
+		drv_event_eapol_rx_vlan(bss->ctx, src_addr,
+					 frame, frame_len, encrypted, link_id,
+					 vlan_id);
+		break;
+	case ETH_P_8021Q:
+		frame = ieee802_11_parse_vlan_hdr(frame, &frame_len, &vlan_id,
+						  &inner_proto);
+		if (!frame) {
+			wpa_printf(MSG_INFO,
+				   "nl80211: Too short VLAN frame from "
+				   MACSTR " over control port",
+				   MAC2STR(src_addr));
+			break;
+		}
+
+		if (inner_proto != ETH_P_PAE) {
+			wpa_printf(MSG_INFO,
+				   "nl80211: Unexpected VLAN inner ethertype "
+				   "0x%04x from " MACSTR
+				   " over control port",
+				   inner_proto, MAC2STR(src_addr));
+			break;
+		}
+
+		drv_event_eapol_rx_vlan(bss->ctx, src_addr,
+					 frame, frame_len, encrypted, link_id,
+					 vlan_id);
 		break;
 	default:
 		wpa_printf(MSG_INFO,
diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
