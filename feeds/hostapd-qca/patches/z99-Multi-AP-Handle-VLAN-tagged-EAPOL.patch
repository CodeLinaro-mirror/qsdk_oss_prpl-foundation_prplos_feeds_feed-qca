 		      union wpa_event_data *data)
 {
@@ -6937,6 +6963,10 @@ void supplicant_event(void *ctx, enum wpa_event_type event,
 #endif /* CONFIG_NAN_USD */
 		break;
 	case EVENT_EAPOL_RX:
+		if (!multi_ap_eapol_vlan_id_check(wpa_s, data->eapol_rx.src,
+						   data->eapol_rx.vlan_id))
+			return;
+
 		wpa_supplicant_rx_eapol(wpa_s, data->eapol_rx.src,
 					data->eapol_rx.data,
 					data->eapol_rx.data_len,
