diff --git a/src/common/ieee802_11_common.c b/src/common/ieee802_11_common.c
index cb1d02d..a1a78fa 100644
--- a/src/common/ieee802_11_common.c
+++ b/src/common/ieee802_11_common.c
@@ -3729,3 +3729,48 @@ u8 get_link_id(const u8 *ml_ie)
        link_id = ml_ie[link_id_pos] & 0x0f;
        return link_id;
 }
+
+
+struct vlan_hdr {
+	be16 h_vlan_TCI;
+	be16 h_vlan_encapsulated_proto;
+} STRUCT_PACKED;
+
+
+u16 ieee802_11_add_vlan_hdr(u8 **buffer, u16 vlan_id, u16 encap_proto,
+			    const u8 *data, size_t *len)
+{
+	struct vlan_hdr *vlan_hdr;
+
+	*buffer = os_zalloc(sizeof(*vlan_hdr) + *len);
+	if (!*buffer) {
+		wpa_printf(MSG_ERROR, "%s: Failed to allocate VLAN header",
+			   __func__);
+		return encap_proto;
+	}
+
+	vlan_hdr = (struct vlan_hdr *) *buffer;
+	vlan_hdr->h_vlan_TCI = host_to_be16(vlan_id);
+	vlan_hdr->h_vlan_encapsulated_proto = host_to_be16(encap_proto);
+	os_memcpy(vlan_hdr + 1, data, *len);
+	*len += sizeof(*vlan_hdr);
+
+	return ETH_P_8021Q;
+}
+
+
+const u8 * ieee802_11_parse_vlan_hdr(const u8 *data, size_t *len,
+				     u16 *vlan_id, u16 *encap_proto)
+{
+	const struct vlan_hdr *vlan_hdr;
+
+	if (*len < sizeof(*vlan_hdr))
+		return NULL;
+
+	vlan_hdr = (const struct vlan_hdr *) data;
+	*vlan_id = be_to_host16(vlan_hdr->h_vlan_TCI) & 0x0fff;
+	*encap_proto = be_to_host16(vlan_hdr->h_vlan_encapsulated_proto);
+	*len -= sizeof(*vlan_hdr);
+
+	return data + sizeof(*vlan_hdr);
+}
