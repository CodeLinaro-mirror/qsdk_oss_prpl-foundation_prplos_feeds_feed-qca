+static int parse_ueqm_pattern(const char *arg, unsigned int *pattern)
+{
+	char *fc = strchr(arg, ':');
+	char *lc = strrchr(arg, ':');
+
+	if (!fc || !lc)
+		return 0;
+
+	if ((fc != lc) &&
+	    (strchr(fc + 1, ':') == lc)) {
+		if (!sscanf(lc + 1, "%u", pattern))
+			return 0;
+	} else {
+		return 0;
+	}
+
+	return 1;
+}
+
+static bool allowed_ueqm_pattern(__u8 nss, __u8 mcs, int pattern)
+{
+	/*
+	 * Per IEEE P802.11bn D1.4 (Tables 38‑33/38‑34):
+	 * UEQM applies only when using 2 to 4 spatial streams.
+	 * UEQM pattern 0 allows only MCS 3 to 13, 19, 23.
+	 * UEQM patterns 1 to 3 allow only MCS 5, 6, 8 to 13, 23.
+	 */
+
+	if (pattern > 3)
+		return false;
+
+	if (nss < 2 || nss > 4)
+		return false;
+
+	if ((nss == 2 && pattern > 1) ||
+	    (nss == 3 && pattern > 2) ||
+	    (nss == 4 && pattern > 3))
+		return false;
+
+	if (pattern == 0 &&
+	    (!((mcs >= 3 && mcs <= 13) || mcs == 19 || mcs == 23)))
+			return false;
+	else if (pattern != 0 &&
+		 (!(mcs == 5 || mcs == 6 ||
+		    (mcs >= 8 && mcs <= 13) || mcs == 23)))
+			return false;
+
+	return true;
+}
+
+static int parse_uhr_rates(const char *arg, __u8 *nss, __u32 *mcs,
+			   struct nl80211_uhr_ueqm_pattern *ueqm_pattern)
+{
+	unsigned int count;
+	char *chunk;
+	int imcs, pattern;
+	int inss;
+	char buf[128] = {};
+	size_t size;
+	char *p, *s;
+
+	if (sscanf(arg, "%d", &inss) != 1)
+		return 0;
+
+	s = strchr(arg, ':');
+	if (!s)
+		return 0;
+	s++;
+	p = buf;
+	size = ((strlen(s) < sizeof(buf) - 1) ?
+		strlen(s) : sizeof(buf) - 1) + 1;
+	if (!size)
+		return 0;
+	memcpy(p, s, size);
+
+	*nss = inss;
+	while ((chunk = strsep(&p, ",")) != NULL) {
+		count = sscanf(chunk, "%d:%d", &imcs, &pattern);
+		if (imcs > 13 &&
+		    !(imcs == 15 || imcs == 17 || imcs == 19 ||
+		      imcs == 20 || imcs == 23))
+			return 0;
+
+		if (count == 2) {
+			/* MCS:UEQMP*/
+			if (!allowed_ueqm_pattern(inss, imcs, pattern))
+				return 0;
+
+			*mcs |= 1 << imcs;
+			ueqm_pattern->pattern[inss - 2][imcs/2] |=
+					BIT(pattern) << (imcs & BIT(0)) * 4;
+		} else if (count == 1) {
+			/* MCS only*/
+			*mcs |= 1 << imcs;
+		} else {
+			return 0;
+		}
+	}
 
-static int parse_rate_chunk(const char *arg, __u8 *nss, __u16 *mcs, unsigned int mode)
+	return 1;
+}
+
+static int parse_rate_chunk(const char *arg, __u8 *nss, __u32 *mcs,
+			    struct nl80211_uhr_ueqm_pattern *ueqm_pattern, unsigned int mode)
 {
 	unsigned int count, i;
-	unsigned int inss, mcs_start, mcs_end, tab[14];
+	unsigned int inss, mcs_start, mcs_end, tab[18];
 	unsigned int max_mcs = 0, max_nss = 0;
+	unsigned int pattern;
 
 	*nss = 0; *mcs = 0;
 
-	if (mode == NL80211_TXRATE_EHT) {
+	if (mode == NL80211_TXRATE_UHR) {
+		max_mcs = 23;
+		max_nss = NL80211_UHR_NSS_MAX;
+	} else if (mode == NL80211_TXRATE_EHT) {
 		max_mcs = 15;
 		max_nss = NL80211_EHT_NSS_MAX;
 	} else if (mode == NL80211_TXRATE_HE) {
@@ -40,12 +146,34 @@ static int parse_rate_chunk(const char *arg, __u8 *nss, __u16 *mcs, unsigned int
 			return 0;
 
 		*nss = inss;
-		for (i = mcs_start; i <= mcs_end; i++)
+		for (i = mcs_start; i <= mcs_end; i++) {
+			if (i > 15 &&
+			    !(i == 17 || i == 19 || i == 20 || i == 23))
+				continue;
+
+			if (i == 14 && mode == NL80211_TXRATE_UHR)
+				continue;
+
 			*mcs |= 1 << i;
+		}
+
+		if (mode == NL80211_TXRATE_UHR) {
+			if (!parse_ueqm_pattern(arg, &pattern))
+				return 1;
 
+			for (i = mcs_start; i <= mcs_end; i++) {
+				if (!allowed_ueqm_pattern(inss, i, pattern))
+					return 0;
+
+				ueqm_pattern->pattern[inss - 2][i/2] |=
+					BIT(pattern) << (i & BIT(0)) * 4;
+			}
+		}
 	} else {
 		/* Format: NSS:MCSx,MCSy,... */
-		if (mode == NL80211_TXRATE_EHT) {
+		if (mode == NL80211_TXRATE_UHR) {
+			return parse_uhr_rates(arg, nss, mcs, ueqm_pattern);
+		} else if (mode == NL80211_TXRATE_EHT) {
 			count = sscanf(arg, "%u:%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u",
 				       &inss, &tab[0], &tab[1], &tab[2], &tab[3],
 				       &tab[4], &tab[5], &tab[6], &tab[7], &tab[8],
@@ -69,35 +197,44 @@ static int parse_rate_chunk(const char *arg, __u8 *nss, __u16 *mcs, unsigned int
 
 		*nss = inss;
 		for (i = 0; i < count - 1; i++) {
-			if (tab[i] > max_mcs)
+			if (tab[i] > max_mcs ||
+			    (tab[i] > 15 &&
+			    !(tab[i] == 17 || tab[i] == 19 ||
+			      tab[i] == 20 || tab[i] == 23)))
 				return 0;
 			*mcs |= 1 << tab[i];
 		}
 	}
-
 	return 1;
 }
 
-static int parse_vht_chunk(const char *arg, __u8 *nss, __u16 *mcs)
+static int parse_vht_chunk(const char *arg, __u8 *nss, __u32 *mcs)
