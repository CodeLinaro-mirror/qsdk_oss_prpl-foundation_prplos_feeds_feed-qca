+static int setup_uhr(struct nl80211_txrate_uhr *txrate_uhr,
+		     int argc, char **argv,
+		     struct nl80211_uhr_ueqm_pattern *ueqm_pattern,
+		     int *has_uhr_up)
+{
+	__u8 nss;
+	__u32 mcs;
+	int i,j;
+
+	memset(txrate_uhr, 0, sizeof(*txrate_uhr));
+
+	for (i = 0; i < argc; i++) {
+		if (!parse_uhr_chunk(argv[i], &nss, &mcs, ueqm_pattern))
+			return 0;
+
+		nss--;
+		txrate_uhr->mcs[nss] |= mcs;
+	}
+
+	for (i = 0; i < NL80211_UHR_UEQM_NSS_COUNT; i++) {
+		for (j = 0; j < NL80211_UHR_UEQM_MCS_COL_COUNT; j++) {
+			if (ueqm_pattern->pattern[i][j]) {
+				*has_uhr_up = 1;
+				break;
+			}
+		}
 	}
 
 	return 1;
@@ -191,6 +359,24 @@ static int parse_eht_gi(char *eht_gi)
 	return -1;
 }
 
+#define UHR_GI_STR_MAX	16
+#define UHR_GI_08_STR "0.8"
+#define UHR_GI_16_STR "1.6"
+#define UHR_GI_32_STR "3.2"
+static int parse_uhr_gi(char *uhr_gi)
+{
+	if (uhr_gi == NULL)
+		return 0;
+
+	if (!strncmp(uhr_gi, UHR_GI_08_STR, sizeof(UHR_GI_08_STR)))
+		return NL80211_RATE_INFO_UHR_GI_0_8;
+	if (!strncmp(uhr_gi, UHR_GI_16_STR, sizeof(UHR_GI_16_STR)))
+		return NL80211_RATE_INFO_UHR_GI_1_6;
+	if (!strncmp(uhr_gi, UHR_GI_32_STR, sizeof(UHR_GI_32_STR)))
+		return NL80211_RATE_INFO_UHR_GI_3_2;
+
+	return -1;
+}
 
