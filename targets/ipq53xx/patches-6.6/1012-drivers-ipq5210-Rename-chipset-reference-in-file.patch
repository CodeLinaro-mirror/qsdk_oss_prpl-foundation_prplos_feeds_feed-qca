+++ b/Documentation/devicetree/bindings/phy/qcom,sc8280xp-qmp-usb3-uni-phy.yaml
@@ -18,7 +18,7 @@ properties:
     enum:
       - qcom,ipq9574-qmp-usb3-phy
       - qcom,ipq5424-qmp-usb3-phy
-      - qcom,ipq5200-qmp-usb3-phy
+      - qcom,ipq5210-qmp-usb3-phy
       - qcom,qcm2290-qmp-usb3-phy
       - qcom,sa8775p-qmp-usb3-uni-phy
       - qcom,sc8280xp-qmp-usb3-uni-phy
@@ -78,7 +78,7 @@ allOf:
             enum:
               - qcom,ipq9574-qmp-usb3-phy
               - qcom,ipq5424-qmp-usb3-phy
-              - qcom,ipq5200-qmp-usb3-phy
+              - qcom,ipq5210-qmp-usb3-phy
     then:
       properties:
         clock-names:
diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index 6115a1312338..2e8e17caa9ed 100644
--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -161,10 +161,10 @@ config IPQ_GCC_5018
 	  Say Y if you want to use peripheral devices such as UART, SPI,
 	  i2c, USB, SD/eMMC, etc.
 
-config IPQ_GCC_5200
-	tristate "IPQ5200 Global Clock Controller"
+config IPQ_GCC_5210
+	tristate "IPQ5210 Global Clock Controller"
 	help
-	  Support for the global clock controller on ipq5200 devices.
+	  Support for the global clock controller on ipq5210 devices.
 	  Say Y if you want to use peripheral devices such as UART, SPI,
 	  i2c, USB, SD/eMMC, etc.
 
@@ -232,11 +232,11 @@ config IPQ_GCC_9679
 	  i2c, USB, SD/eMMC, etc. Select this for the root clock
 	  of ipq9679.
 
-config IPQ_NSSCC_5200
-        tristate "IPQ5200 NSS Clock Controller"
-        depends on IPQ_GCC_5200
+config IPQ_NSSCC_5210
+        tristate "IPQ5210 NSS Clock Controller"
+        depends on IPQ_GCC_5210
         help
-          Support for NSS clock controller on ipq5200 devices.
+          Support for NSS clock controller on ipq5210 devices.
 
 config IPQ_NSSCC_5332
         tristate "IPQ5332 NSS Clock Controller"
