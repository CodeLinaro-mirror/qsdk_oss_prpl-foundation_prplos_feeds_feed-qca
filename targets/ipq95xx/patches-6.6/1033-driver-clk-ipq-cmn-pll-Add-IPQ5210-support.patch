 {
 	struct clk_parent_data pdata = { .index = 0 };
@@ -336,6 +596,7 @@ static struct clk_hw *ipq_cmn_pll_clk_hw_register(struct platform_device *pdev)
 
 	cmn_pll->hw.init = &init;
 	cmn_pll->regmap = regmap;
