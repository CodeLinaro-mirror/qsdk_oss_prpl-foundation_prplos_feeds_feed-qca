From ad6a6f4a36e7ae044e9ac925bd010a87f61d7f62 Mon Sep 17 00:00:00 2001
From: Sumit Garg <sumit.garg@oss.qualcomm.com>
Date: Sun, 22 Feb 2026 23:05:04 +0530
Subject: [PATCH] drivers: remoteproc: PAS Skeleton support for using Optee

Add base changes to support QCOM Remoteproc PAS framework via
OPTEE.

Change-Id: If4c17be4e74663e1c9f46ee37bacfc6b63940a7e
Signed-off-by: Sumit Garg <sumit.garg@oss.qualcomm.com>
Signed-off-by: Vignesh Viswanathan <viswanat@qti.qualcomm.com>
---
 drivers/firmware/Kconfig               | 17 +++++
 drivers/firmware/Makefile              |  2 +
 drivers/firmware/qcom_scm.c            | 93 +++++++++++++++++++-------
 drivers/remoteproc/Kconfig             |  3 +-
 drivers/remoteproc/qcom_q6v5_pas.c     | 33 ++++-----
 drivers/soc/qcom/mdt_loader.c          |  7 +-
 include/linux/firmware/qcom/qcom_scm.h | 13 ----
 include/linux/soc/qcom/mdt_loader.h    |  6 +-
 8 files changed, 112 insertions(+), 62 deletions(-)

diff --git a/drivers/firmware/Kconfig b/drivers/firmware/Kconfig
index 8ecffdce94b1..80449f1c0e21 100644
--- a/drivers/firmware/Kconfig
+++ b/drivers/firmware/Kconfig
@@ -211,7 +211,24 @@ config MTK_ADSP_IPC
 	  ADSP exists on some mtk processors.
 	  Client might use shared memory to exchange information with ADSP.
 
+config QCOM_PAS
+	tristate "QCOM Peripheral Authentication Service framework"
+	help
+	  Enable the generic Peripheral Authentication Service (PAS) provided
+	  by the firmware. It acts as the common layer with different TZ
+	  backends plugged in whether it's an SCM implementation or a proper
+	  TEE bus based PAS service implementation.
+
+config QCOM_PAS_TEE
+	tristate "QCOM PAS framework provided by TEE"
+	depends on TEE
+	select QCOM_PAS
+	help
+	  Enable the generic Peripheral Authentication Service (PAS) provided
+	  by the firmware TEE implementation as the backend.
+
 config QCOM_SCM
+	select QCOM_PAS
 	tristate
 
 config QCOM_SCM_DOWNLOAD_MODE_DEFAULT
diff --git a/drivers/firmware/Makefile b/drivers/firmware/Makefile
index 28fcddcd688f..471c16a24aa0 100644
--- a/drivers/firmware/Makefile
+++ b/drivers/firmware/Makefile
@@ -20,6 +20,8 @@ obj-$(CONFIG_RASPBERRYPI_FIRMWARE) += raspberrypi.o
 obj-$(CONFIG_FW_CFG_SYSFS)	+= qemu_fw_cfg.o
 obj-$(CONFIG_QCOM_SCM)		+= qcom-scm.o
 qcom-scm-objs += qcom_scm.o qcom_scm-smc.o qcom_scm-legacy.o
+obj-$(CONFIG_QCOM_PAS)		+= qcom_pas.o
+obj-$(CONFIG_QCOM_PAS_TEE)	+= qcom_pas_tee.o
 obj-$(CONFIG_SYSFB)		+= sysfb.o
 obj-$(CONFIG_SYSFB_SIMPLEFB)	+= sysfb_simplefb.o
 obj-$(CONFIG_TI_SCI_PROTOCOL)	+= ti_sci.o
diff --git a/drivers/firmware/qcom_scm.c b/drivers/firmware/qcom_scm.c
