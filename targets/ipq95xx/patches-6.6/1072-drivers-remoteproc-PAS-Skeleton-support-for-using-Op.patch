 	ret = qcom_scm_clk_enable();
@@ -740,7 +743,7 @@ int qcom_scm_pas_init_image(u32 peripheral, const void *metadata, size_t size,
 
 	desc.args[1] = mdata_phys;
 
-	if (__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_PIL,
